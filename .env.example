# ==============================================================================
# KAI Student OS 2.0 - Environment Configuration Template
# Скопируйте этот файл в .env и укажите ваши реальные параметры:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot (Aiogram 3 & Alerts)
# ------------------------------------------------------------------------------
# Токен бота от @BotFather (например: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Числовой ID вашего Telegram-аккаунта (получить можно у @userinfobot)
TG_USER_ID=123456789

# Необязательный reverse-proxy для Telegram Bot API (при блокировках или ограничениях)
TG_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Telegram Userbot (Telethon / мониторинг чатов старост - опционально)
# ------------------------------------------------------------------------------
# Получить можно на https://my.telegram.org в разделе API development tools
TG_API_ID=
TG_API_HASH=

# ------------------------------------------------------------------------------
# 3. Настройки студента КНИТУ-КАИ
# ------------------------------------------------------------------------------
# Номер вашей учебной группы
KAI_GROUP=5108

# Номер вашей подгруппы (1 или 2) для точной фильтрации лабораторных и практик
KAI_SUBGROUP=2

# URL открытого API расписания КАИ
KAI_API_URL=https://kai.ru/web/studentu/raspisanie1

# ------------------------------------------------------------------------------
# 4. Авторизация Blackboard Learn (bb.kai.ru)
# ------------------------------------------------------------------------------
# Логин студента от личного кабинета Blackboard (например: IvanovII)
BB_LOGIN=your_bb_login

# Пароль от личного кабинета Blackboard
BB_PASSWORD=your_bb_password

# Базовый адрес портала Blackboard
BB_URL=https://bb.kai.ru

# ------------------------------------------------------------------------------
# 5. База данных
# ------------------------------------------------------------------------------
# Строка подключения SQLAlchemy Async. По умолчанию локальная SQLite база данных
DATABASE_URL=sqlite+aiosqlite:///kai_assistant.db

# ------------------------------------------------------------------------------
# 6. Веб-сервер FastAPI и PWA
# ------------------------------------------------------------------------------
# Хост и порт для локального веб-сервера
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Автоматический запуск безопасного внешнего HTTPS-туннеля для смартфона (True / False)
ENABLE_TUNNEL=True

# ------------------------------------------------------------------------------
# 7. Google Gemini AI Assistant
# ------------------------------------------------------------------------------
# API-ключ Google AI Studio (получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Модель Gemini для анализа текста задач и генерации шпаргалок к лабам
# Доступные: gemini-3.8-flash, gemini-2.5-flash-lite, gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 8. Безопасность API и авторизация PWA (Sprint 6)
# ------------------------------------------------------------------------------
# Секретный мастер-токен / пин-код для доступа к API и PWA
APP_AUTH_TOKEN=your_secure_random_token_here

